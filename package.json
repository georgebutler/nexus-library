{
  "name": "nexus-library",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgebutler/nexus-library.git"
  },
  "homepage": "https://nexus-library-six.vercel.app",
  "bugs": {
    "url": "https://github.com/georgebutler/nexus-library/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint app next.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs --view=all",
    "screenshots:readme:library": "node scripts/capture-readme-screenshots.mjs --view=library",
    "screenshots:readme:details": "node scripts/capture-readme-screenshots.mjs --view=details",
    "spatial": "webspatial-builder run --base=http://localhost:3000"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@webspatial/core-sdk": "1.7.0",
    "@webspatial/react-sdk": "1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.544.0",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@webspatial/builder": "1.7.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
